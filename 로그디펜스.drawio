<diagram id="page-3" name="성장"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Rushitadel · 강화와 연결형 성장" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontSize=24;fillColor=none;strokeColor=none;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1120" height="50" as="geometry"/></mxCell><mxCell id="slot" value="T1~T5 중 대상 선택&#xa;최대 +12" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="220" height="80" as="geometry"/></mxCell><mxCell id="gold" value="골드·단계·조건 검증&#xa;부족 / MAX이면 거절" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=10;" vertex="1" parent="1"><mxGeometry x="400" y="130" width="220" height="80" as="geometry"/></mxCell><mxCell id="milestone" value="목표 단계&#xa;+3 / +6 / +9 / +12 ?" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontSize=16;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=10;" vertex="1" parent="1"><mxGeometry x="780" y="130" width="280" height="90" as="geometry"/></mxCell><mxCell id="stats" value="일반 강화&#xa;선택 포탑 스탯 적용" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=10;" vertex="1" parent="1"><mxGeometry x="780" y="310" width="220" height="80" as="geometry"/></mxCell><mxCell id="variant" value="+3&#xa;변형 후보 3개 중 1개" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontSize=16;fillColor=#d5e8d4;strokeColor