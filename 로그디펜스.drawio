<diagram id="page-4" name="저장과 제작"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Rushitadel · 체크포인트 저장 제안 / 제작 기준" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontSize=24;fillColor=none;strokeColor=none;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1120" height="50" as="geometry"/></mxCell><mxCell id="point" value="안전 저장점&#xa;테마 확정·정비 완료·보스 보상 확정" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="450" height="90" as="geometry"/></mxCell><mxCell id="slots" value="저장 슬롯 3개&#xa;덮어쓰기 사용자 확인" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=10;" vertex="1" parent="1"><mxGeometry x="730" y="130" width="330" height="90" as="geometry"/></mxCell><mxCell id="data" value="런 ID·시드·진행·사용 테마&#xa;플레이어 HP·자원·T1~T5 빌드&#xa;Web ID·미완료 선택·보상 지급 여부" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontSize=16;fillColor=#f5f5f5;strokeColor=#666666;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="450" height="130" as="geometry"/></mxCell><mxCell id="save" value="임시 저장 → 검증 → 교체&#xa;직전 정상본 보존" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;spacing=10;" vertex="1" parent="1"><mxGeometry x="730" y="310" width="330" height="100" as="geometry"/></mxCell><mxCell id="restore" value="불러오기&#xa;버전·ID·필드 검증 후 복원" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;font